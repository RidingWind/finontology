<owl:DatatypeProperty rdf:about="#eastIssueDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTLoanItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">发放日期</rdfs:label>
