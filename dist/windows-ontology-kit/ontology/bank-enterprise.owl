<owl:NamedIndividual rdf:about="#MapCustomerCode">
  <rdf:type rdf:resource="#FieldMapping"/>
  <inSpecification rdf:resource="#SpecEAST2026Q3"/>
  <mapsSourceField rdf:resource="#SF_CustNo"/>
  <usesTransformationRule rdf:resource="#RuleDirect"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户编号映射</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户主题域客户编号字段的取数映射。</rdfs:comment>
  <mappingCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M-EAST-CUS-001</mappingCode>
  <targetOntologyProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eastCustomerCode</targetOntologyProperty>
  <targetDomainClass rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EASTCustomerItem</targetDomainClass>
  <sourceSystemName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">核心业务系统</sourceSystemName>
  <sourceTableCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CB_CUSTOMER</sourceTableCode>
  <sourceFieldCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CUST_NO</sourceFieldCode>
  <sourceFieldType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VARCHAR(20)</sourceFieldType>
  <transformationType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">直接映射</transformationType>
  <transformationExpression rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target = CUST_NO</transformationExpression>
  <isRequired rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isRequired>
  <mappingStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已确认</mappingStatus>
  <mappingConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">拟定</mappingConfidence>
  <mappingNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">官方数据项编号待规范下发后回填。</mappingNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MapCustomerName">
  <rdf:type rdf:resource="#FieldMapping"/>
  <inSpecification rdf:resource="#SpecEAST2026Q3"/>
  <mapsSourceField rdf:resource="#SF_CustName"/>
  <usesTransformationRule rdf:resource="#RuleDirect"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户名称映射</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户主题域客户名称字段的取数映射。</rdfs:comment>
  <mappingCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M-EAST-CUS-002</mappingCode>
  <targetOntologyProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eastCustomerName</targetOntologyProperty>
  <targetDomainClass rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EASTCustomerItem</targetDomainClass>
  <sourceSystemName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">核心业务系统</sourceSystemName>
  <sourceTableCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CB_CUSTOMER</sourceTableCode>
  <sourceFieldCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CUST_NAME</sourceFieldCode>
  <sourceFieldType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VARCHAR(200)</sourceFieldType>
  <transformationType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">直接映射</transformationType>
  <transformationExpression rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target = CUST_NAME</transformationExpression>
  <isRequired rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isRequired>
  <mappingStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已确认</mappingStatus>
  <mappingConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">拟定</mappingConfidence>
  <mappingNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">官方数据项编号待规范下发后回填。</mappingNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MapIdType">
  <rdf:type rdf:resource="#FieldMapping"/>
  <inSpecification rdf:resource="#SpecEAST2026Q3"/>
  <mapsSourceField rdf:resource="#SF_IdType"/>
  <usesTransformationRule rdf:resource="#RuleCodeConversion"/>
  <usesCodeMapping rdf:resource="#CodeMapIdType"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">证件类型映射</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户主题域证件类型字段的代码转换映射。</rdfs:comment>
  <mappingCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M-EAST-CUS-003</mappingCode>
  <targetOntologyProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eastIdType</targetOntologyProperty>
  <targetDomainClass rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EASTCustomerItem</targetDomainClass>
  <sourceSystemName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">核心业务系统</sourceSystemName>
  <sourceTableCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CB_CUSTOMER</sourceTableCode>
  <sourceFieldCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ID_TYPE</sourceFieldCode>
  <sourceFieldType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHAR(2)</sourceFieldType>
  <transformationType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">代码转换</transformationType>
  <transformationExpression rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target = codeMap[ID_TYPE]</transformationExpression>
  <isRequired rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isRequired>
  <mappingStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已确认</mappingStatus>
  <mappingConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">拟定</mappingConfidence>
  <mappingNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">完整代码表须以官方规范为准，当前仅示例一档。</mappingNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MapCustomerType">
  <rdf:type rdf:resource="#FieldMapping"/>
  <inSpecification rdf:resource="#SpecEAST2026Q3"/>
  <mapsSourceField rdf:resource="#SF_CustType"/>
  <usesTransformationRule rdf:resource="#RuleConditional"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户类型映射</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户主题域客户类型字段的条件分支映射。</rdfs:comment>
  <mappingCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M-EAST-CUS-004</mappingCode>
  <targetOntologyProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eastCustomerType</targetOntologyProperty>
  <targetDomainClass rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EASTCustomerItem</targetDomainClass>
  <sourceSystemName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">核心业务系统</sourceSystemName>
  <sourceTableCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CB_CUSTOMER</sourceTableCode>
  <sourceFieldCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CUST_KIND</sourceFieldCode>
  <sourceFieldType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHAR(1)</sourceFieldType>
  <transformationType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">条件分支</transformationType>
  <transformationExpression rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target = (CUST_KIND == 'C') ? '对公客户' : '对私客户'</transformationExpression>
  <isRequired rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isRequired>
  <mappingStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">待确认</mappingStatus>
  <mappingConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">拟定</mappingConfidence>
  <mappingNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对公对私分类粒度须对照官方口径确认。</mappingNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MapRegisterAddress">
  <rdf:type rdf:resource="#FieldMapping"/>
  <inSpecification rdf:resource="#SpecEAST2026Q3"/>
  <usesTransformationRule rdf:resource="#RuleConcat"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">注册地址映射</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户主题域注册地址字段的拼接映射。</rdfs:comment>
  <mappingCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M-EAST-CUS-005</mappingCode>
  <targetOntologyProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eastRegisterAddress</targetOntologyProperty>
  <targetDomainClass rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EASTCustomerItem</targetDomainClass>
  <sourceSystemName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">核心业务系统</sourceSystemName>
  <sourceTableCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CB_CUSTOMER</sourceTableCode>
  <sourceFieldCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">REG_PROV+REG_CITY+REG_ADDR</sourceFieldCode>
  <sourceFieldType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VARCHAR(280)</sourceFieldType>
  <transformationType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">字符串拼接</transformationType>
  <transformationExpression rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target = REG_PROV + REG_CITY + REG_ADDR</transformationExpression>
  <isRequired rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isRequired>
  <mappingStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已确认</mappingStatus>
  <mappingConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">拟定</mappingConfidence>
  <mappingNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">多源字段映射，故不设 mapsSourceField，来源记于表达式。</mappingNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MapIndustryCode">
  <rdf:type rdf:resource="#FieldMapping"/>
  <inSpecification rdf:resource="#SpecEAST2026Q3"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">行业代码映射（未映射）</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户主题域行业代码字段尚未确定取数来源。</rdfs:comment>
  <mappingCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M-EAST-CUS-006</mappingCode>
  <targetOntologyProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eastIndustryCode</targetOntologyProperty>
  <targetDomainClass rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EASTCustomerItem</targetDomainClass>
  <transformationType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">直接映射</transformationType>
  <isRequired rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isRequired>
  <mappingStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">未映射</mappingStatus>
  <mappingConfidence rdf:datatype="http://www.w3.org/2001/XMLSchema#string">拟定</mappingConfidence>
  <mappingNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源字段待数据字典梳理后补充；该条目用于演示覆盖率校验。</mappingNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MapAccountNo">
  <rdf:type rdf:resource="#FieldMapping"/>
  <inSpecification rdf:resource="#SpecEAST2026Q3"/>
  <mapsSourceField rdf:resource="#SF_AcctNo"/>
  <usesTransformationRule rdf:resource="#RuleDirect"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账号映射</rdfs:label>
