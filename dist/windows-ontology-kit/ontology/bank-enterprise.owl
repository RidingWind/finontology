  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CashTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">现金凭证号</rdfs:label>
