  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">注册地址</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户登记注册地址。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastAccountNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTAccountItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送口径下的账户编号，为源实体属性 Account.accountNumber 在报送时点的快照值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastAccountType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTAccountItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账户类型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账户种类代码，如基本户、一般户、专用户。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastAccountCurrency">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTAccountItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账户币种</rdfs:label>
