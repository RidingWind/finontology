  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTDepositItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">存款利率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">存款执行年利率。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastDepositTerm">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTDepositItem"/>
