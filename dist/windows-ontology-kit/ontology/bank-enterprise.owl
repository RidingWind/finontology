</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#merchantName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CardTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">商户名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受理交易的商户名称。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#terminalCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CardTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受理终端代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">完成交易受理的终端编号。</rdfs:comment>
