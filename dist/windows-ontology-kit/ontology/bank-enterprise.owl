<owl:DatatypeProperty rdf:about="#reportFrequency">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#RegulatoryReport"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送频度</rdfs:label>
