</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastContractNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTLoanItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">合同编号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款合同编号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastLoanProduct">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTLoanItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款品种</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款产品品种代码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastLoanAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTLoanItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款合同金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastLoanBalance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
