</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastLoanMaturityDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTLoanItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款到期日</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款合同约定到期日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastLoanRate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTLoanItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款利率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款执行年利率。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastGuaranteeType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTLoanItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保方式</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">信用、保证、抵押、质押等担保方式代码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastFiveClass">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTLoanItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">五级分类</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">正常、关注、次级、可疑、损失分类结果。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastRepayMethod">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTLoanItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">还款方式</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">等额本息、到期一次还本付息等方式代码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastTxnSerialNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTTransactionItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易流水号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易的唯一流水编号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastTxnAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTTransactionItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易发生金额，为源实体属性 FinancialTransaction.transactionAmount 在报送时点的快照值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastTxnDirection">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTTransactionItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易方向</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资金收付方向，如借、贷。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastTxnType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTTransactionItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易类型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易品种分类代码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastTxnTime">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTTransactionItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易时间</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易发生时间戳，为源实体属性 FinancialTransaction.transactionTimestamp 在报送时点的快照值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastCounterAccount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTTransactionItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对手账号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易对手方账号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastCounterName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTTransactionItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对手名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易对手方名称。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastTxnSummary">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTTransactionItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易摘要</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易用途或摘要说明。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastTxnChannel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTTransactionItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易渠道</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易发生的渠道代码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastPostBalance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTTransactionItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易后余额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易发生后账户余额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastBillNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTBillItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据号码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据的唯一票号，票交所口径唯一标识，为源实体属性 Bill.billNo 在报送时点的快照值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastBillType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTBillItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据类型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据种类代码，如银行承兑汇票、商业承兑汇票。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastDrawerName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTBillItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">出票人名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据出票人的法定名称。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastDrawerAccount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTBillItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">出票人账号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">出票人在本行的结算账号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastPayeeName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTBillItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">收款人名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据收款人的法定名称。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastAcceptorName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTBillItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">承兑人名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">承担票据到期付款责任的承兑人名称。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastBillAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTBillItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票面金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据票面记载的金额，为源实体属性 Bill.billAmount 在报送时点的快照值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastBillIssueDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTBillItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">出票日期</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据签发日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastBillMaturityDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTBillItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据到期日</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据约定付款到期日期，为源实体属性 Bill.billMaturityDate 在报送时点的快照值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastDiscountRate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTBillItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贴现利率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">办理贴现时执行的年利率。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastDiscountAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTBillItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贴现金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">扣除贴现利息后实际支付给申请人的金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastBillStatus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTBillItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据状态</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据状态代码，如正常、已贴现、已结清、逾期、拒付。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastInterbankNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTInterbankItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务编号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务合同或成交单的唯一编号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastCounterpartyCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTInterbankItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易对手机构代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业交易对手的金融机构编码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastCounterpartyName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTInterbankItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易对手机构名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业交易对手机构的法定全称。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastCounterpartyType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTInterbankItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易对手类型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易对手机构类型代码，如政策性银行、商业银行、非银金融机构。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastInterbankType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTInterbankItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务类型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务品种代码，如拆借、存放、买入返售、同业存单。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastInterbankAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTInterbankItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务成交本金金额，为源实体属性 InterbankBusiness.interbankAmount 在报送时点的快照值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastInterbankRate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTInterbankItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业利率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务执行的年利率，为源实体属性 InterbankBusiness.interbankRate 在报送时点的快照值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastInterbankStartDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTInterbankItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业起息日</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务开始计息日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastInterbankEndDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTInterbankItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业到期日</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务约定到期日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastInterbankTerm">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTInterbankItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">业务期限</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务期限，如隔夜、7天、1个月、1年。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastInterbankBalance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTInterbankItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务余额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送时点同业业务的本金余额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastProductCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTWealthItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产品代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">理财产品的唯一登记编码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastProductName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTWealthItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产品名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">理财产品的对外销售名称。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastProductType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTWealthItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产品类型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产品形态代码，如净值型、预期收益型、结构性。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastProductRiskRating">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTWealthItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产品风险等级</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">理财产品风险评级，如 R1 至 R5，为源实体属性 WealthManagementProduct.productRiskRating 在报送时点的快照值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastProductScale">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTWealthItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产品募集规模</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">理财产品累计募集金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastProductNetValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTWealthItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产品单位净值</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送时点理财产品单位净值，为源实体属性 WealthManagementProduct.productNetValue 在该时点的快照值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastProductIssueDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTWealthItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产品成立日</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">理财产品正式成立起算日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastProductMaturityDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTWealthItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产品到期日</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">理财产品约定到期日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastProductTerm">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTWealthItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产品期限</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">理财产品的存续期限。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastSubscriptionAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTWealthItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">认购金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户认购理财产品的金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastReturnType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTWealthItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">收益类型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">收益特征代码，如保本浮动收益、非保本浮动收益。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastRedemptionStatus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTWealthItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">赎回状态</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户持有份额的赎回状态代码，如持有中、已赎回、部分赎回。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastOffBalanceNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTOffBalanceItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外业务编号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外业务合同或凭证的唯一编号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastOffBalanceType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTOffBalanceItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外业务类型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外业务品种代码，如保函、信用证、承兑、承诺、衍生品。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastOffBalanceAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTOffBalanceItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外业务金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外业务合同名义金额，为源实体属性 OffBalanceCommitment.commitmentAmount 在报送时点的快照值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastOffBalanceBalance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTOffBalanceItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外业务余额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送时点表外业务的敞口余额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastApplicantName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTOffBalanceItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">申请人名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">申请开立表外业务凭证的客户名称。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastBeneficiaryName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTOffBalanceItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受益人名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外业务项下的受益人名称。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastOffBalanceIssueDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTOffBalanceItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">开立日期</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外业务凭证开立日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastOffBalanceExpiryDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTOffBalanceItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">失效日期</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外业务凭证到期或失效日期，为源实体属性 OffBalanceCommitment.commitmentExpiryDate 在报送时点的快照值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastMarginRatio">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTOffBalanceItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">保证金比例</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外业务缴存保证金占业务金额的比例。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastMarginAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTOffBalanceItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">保证金金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外业务缴存的保证金金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastConversionFactor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTOffBalanceItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">信用转换系数</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外业务转换为表内风险敞口的监管系数。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastWeightedAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#EASTOffBalanceItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">加权风险资产额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外业务按转换系数折算后的加权风险资产。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#reportedPeriod">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTDataItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送期间</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送记录所归属的报告期，用于区分同一实体的多期报送记录。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#snapshotTime">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTDataItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">快照时点</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送数据自源系统抽取并冻结的时点，归档后不随源数据变动。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#billNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Bill"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据号码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据的唯一票号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#billAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#Bill"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票面金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据票面记载的金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#billMaturityDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Bill"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据到期日</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据约定付款到期日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#interbankAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#InterbankBusiness"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务成交本金金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#interbankRate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#InterbankBusiness"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业利率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务执行年利率。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#commitmentAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#OffBalanceCommitment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">承诺金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外承担的合同名义金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#commitmentExpiryDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#OffBalanceCommitment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">失效日期</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外承担到期或失效日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#productNetValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#WealthManagementProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产品单位净值</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">理财产品当前单位净值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#productRiskRating">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#WealthManagementProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产品风险等级</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">理财产品风险评级，如 R1 至 R5。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#collateralValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#Collateral"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">押品评估价值</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">押品经评估确认的价值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#assessmentDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Collateral"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">评估基准日</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">押品价值的评估基准日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#collateralCurrency">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Collateral"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">押品币种</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">押品价值计量所采用的币种代码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#beneficialOwnerRatio">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#BeneficialOwner"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受益持股比例</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受益所有人对客户主体的持股比例。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ratingValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CreditRating"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">评级结果</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">信用评级结论，如 AAA、AA、A 等等级。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ratingAgency">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CreditRating"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">评级机构</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">出具评级结果的机构名称。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ratingDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CreditRating"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">评级日期</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">评级结果出具的日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#limitAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#CreditLimit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">额度金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">核定授信额度的金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#limitExpiryDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CreditLimit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">额度到期日</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">授信额度失效日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#indicatorValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#RiskIndicator"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">指标值</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险指标的当前取值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#indicatorThreshold">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#RiskIndicator"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">预警阈值</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">触发风险预警的指标阈值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#userAccountName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#UserAccount"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账号名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">系统账号的登录名。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#userAccountStatus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#UserAccount"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账号状态</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">系统账号状态，如正常、锁定、停用、注销。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#standardCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#DataStandard"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">标准编号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据标准的统一编号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#modelVersion">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#DataModel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">模型版本</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据模型的版本号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#specVersion">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#MappingSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">规格版本</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射规格的版本号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#specScope">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#MappingSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送口径</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射规格所面向的报送口径，如 EAST5.0、一表通2.1。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#specEffectiveDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#MappingSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">生效日期</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射规格生效的报告期起始日。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#mappingCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射编号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">字段映射条目的唯一编号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#targetOntologyProperty">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">目标本体属性</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射目标在本体中的数据属性名，如 eastAccountNo。因本体属性是属性而非实例，只能以名称引用。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#targetDomainClass">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">目标本体类</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射目标属性所属的主题域类，如 EASTAccountItem。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#targetOfficialCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">官方数据项编号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">监管规范下发的数据项编号，待标准到位后填写。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#targetOfficialName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">官方字段名</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">监管规范中的正式字段名，待标准到位后校准。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#sourceSystemName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源系统名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">取数来源的业务系统名称。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#sourceTableCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源表代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">取数来源的表名。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#sourceFieldCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源字段代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">取数来源的字段名。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#sourceFieldType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源字段类型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源字段的类型与长度，如 VARCHAR(32)、DECIMAL(18,2)。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#transformationType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">转换类型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">加工方式：直接映射、代码转换、计算派生、常量赋值、字符串拼接、条件分支。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#transformationExpression">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">转换表达式</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">加工逻辑的可执行描述，供转换引擎解析。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#defaultValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">缺省值</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源值为空时填报的默认值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#isRequired">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">是否必填</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">该报送字段在监管口径下是否必填。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#mappingStatus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射状态</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">取值：未映射、待确认、已确认、不适用。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#mappingConfidence">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射置信度</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">取值：拟定、已校准、已验证。拟定表示尚未对照官方规范。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#mappingNote">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射备注</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射条目的补充说明与待办事项。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#tableName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#SourceTable"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表名</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源系统表的物理表名。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#systemName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#SourceTable"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">所属系统</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源系统表所属的业务系统。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#tableComment">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#SourceTable"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表说明</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源系统表的业务含义说明。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fieldName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#SourceField"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">字段名</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源表字段的物理字段名。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fieldType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#SourceField"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">字段类型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源字段的类型与长度。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fieldNullable">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:domain rdf:resource="#SourceField"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">可否为空</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源字段在源系统中是否允许为空。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ruleExpression">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#TransformationRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">规则表达式</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">转换规则的可执行描述。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#sourceCodeValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CodeMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源代码值</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源系统中的代码取值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#targetCodeValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CodeMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">目标代码值</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">监管口径下的代码取值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#codeTableName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CodeMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">代码表名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">该对照条目所属的代码表。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#coverageRatio">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#MappingCoverage"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">覆盖率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已确认映射字段数占应映射字段总数的比例。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#mappedCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:domain rdf:resource="#MappingCoverage"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已映射数</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已建立映射的字段数量。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#unmappedCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:domain rdf:resource="#MappingCoverage"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">未映射数</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">尚未建立映射的字段数量。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#checkDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#MappingCoverage"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">校验日期</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">覆盖率快照的生成时间。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#organizationCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#InternalOrganization"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">机构代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">机构在全行组织树中的唯一编码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#organizationLevel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#InternalOrganization"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">机构层级</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">机构层级，如总行、分行、支行、网点。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#positionCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Position"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">岗位编码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">岗位在机构内的唯一编码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#positionTitle">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Position"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">岗位名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">岗位的名称。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#subjectCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#AccountingSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">科目代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">会计科目的编码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#subjectName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#AccountingSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">科目名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">会计科目的名称。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#balanceDirection">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#AccountingSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">余额方向</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">科目正常余额所在方向，借或贷。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#voucherNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#AccountingVoucher"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">凭证号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">记账凭证的编号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#accountingDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#AccountingVoucher"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">记账日期</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">凭证的账务处理日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#entryAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#AccountingEntry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">分录金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">分录的发生金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#entrySummary">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#AccountingEntry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">分录摘要</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">分录的业务摘要说明。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#periodCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#AccountingPeriod"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">期间代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">会计期间的编码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#periodStartDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#AccountingPeriod"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">期间起始日</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">会计期间的开始日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#periodEndDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#AccountingPeriod"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">期间结束日</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">会计期间的结束日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#periodStatus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#AccountingPeriod"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">期间状态</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">会计期间状态，如未结账、已结账、已关账。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ledgerBalance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#Ledger"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账簿余额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账簿在某一时点的余额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#guarantorIdentifier">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Guarantor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保人编号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保人的唯一编号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#guaranteeContractNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#GuaranteeContract"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保合同编号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保合同的唯一编号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#guaranteeAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#GuaranteeContract"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保合同所担保的金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#guaranteeMethod">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#GuaranteeContract"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保方式</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保方式，如保证、抵押、质押。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#rateCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#InterestRate"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">利率代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">利率的唯一编码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#rateValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#InterestRate"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">利率值</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">利率的取值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#rateType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#InterestRate"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">利率类型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">利率的期限口径，如年利率、月利率、日利率。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#effectiveDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#InterestRate"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">利率生效日</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">利率开始适用的日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#benchmarkRateName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#BenchmarkRate"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">基准利率名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">基准利率的名称，如 LPR、Shibor。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#floatingMode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#ExecutingRate"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">浮动方式</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">利率的确定方式，如固定、浮动。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#floatingBasisPoint">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#ExecutingRate"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">加减基点</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">在基准利率基础上加减的基点数值。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#feeItemCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FeeItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">收费项目代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">收费项目的编码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#feeRate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#FeeItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">费率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">收费项目的费率。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#feeBasis">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FeeItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">计费基准</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">计费依据，如按笔、按比例、按金额区间。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#scheduleVersion">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FeeSchedule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">价目表版本</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">价目表的版本号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#riskLevelCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CustomerRiskLevel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险等级代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户风险等级的编码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#riskLevelName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CustomerRiskLevel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险等级名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户风险等级名称，如低、中、高。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#riskLevelAssessDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CustomerRiskLevel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">评级日期</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户风险等级的评定日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#dueDiligenceDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#DueDiligence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">尽调日期</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">尽职调查的开展日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#dueDiligenceResult">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#DueDiligence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">尽调结论</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">尽职调查的结论。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#reportNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#SuspiciousTransactionReport"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">可疑报告编号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">可疑交易报告的编号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#reportDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#SuspiciousTransactionReport"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报告日期</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报告的报送日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#largeReportNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#LargeAmountTransactionReport"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">大额报告编号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">大额交易报告的编号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#largeReportDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#LargeAmountTransactionReport"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">大额报告日期</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">大额交易报告的报送日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#screeningResult">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#SanctionsScreening"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">筛查结果</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">制裁名单筛查的结果，如无命中、疑似命中、确认命中。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#screeningDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#SanctionsScreening"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">筛查日期</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">制裁名单筛查的执行日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#screeningListName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#SanctionsScreening"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">名单名称</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">筛查所依据的名单名称。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#exposureAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#Exposure"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">敞口金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险敞口的暴露金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#riskWeight">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#RiskWeightedAsset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险权重</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">该类资产适用的风险权重。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#weightedAssetAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#RiskWeightedAsset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险加权资产额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按风险权重折算后的资产金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#provisionAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#Provision"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">拨备金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">计提的拨备金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#provisionRatio">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#Provision"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">拨备率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">拨备占对应资产余额的比例。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#impairmentAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#Impairment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">减值金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">确认的减值金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#impairmentStage">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Impairment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">减值阶段</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">预期信用损失模型的阶段划分，一至三阶段。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#capitalRatio">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#CapitalAdequacy"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资本充足率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资本与风险加权资产的比率。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#tierOneRatio">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#CapitalAdequacy"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">一级资本充足率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">一级资本净额占风险加权资产的比例。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#mitigationType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#RiskMitigation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">缓释类型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险缓释手段类型，如押品、保证、净额结算。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#batchJobCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#BatchJob"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">作业编码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">批处理作业的编码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#batchJobStatus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#BatchJob"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">作业状态</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">批处理作业状态，如待运行、运行中、成功、失败。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#batchStartTime">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#BatchJob"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">作业开始时间</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">批处理作业的开始时间。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#batchEndTime">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#BatchJob"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">作业结束时间</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">批处理作业的结束时间。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#reconStatus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Reconciliation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对账状态</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对账作业的状态，如相符、有差异、已处理。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#reconDifference">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#Reconciliation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">差异金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对账发现的差异金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#errorCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#OperationalError"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">差错编号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">运营差错的编号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#errorStatus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#OperationalError"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">差错状态</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">差错处理状态，如待更正、已更正、已关闭。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#sessionNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#SettlementSession"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">场次编号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">清算场次的编号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#sessionTime">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#SettlementSession"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">场次时间</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">清算场次的开始时间。</rdfs:comment>
</owl:DatatypeProperty>

<owl:Class rdf:about="#BankParty">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">参与方</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">与银行发生业务往来或承担职责的自然人、法人与组织。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Customer">
  <rdfs:subClassOf rdf:resource="#BankParty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">在银行开立账户、购买产品或接受服务的主体。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PersonalCustomer">
  <rdfs:subClassOf rdf:resource="#Customer"/>
  <owl:disjointWith rdf:resource="#CorporateCustomer"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">个人客户</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以自然人身份开户的客户，受个人身份识别与反洗钱核查约束。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CorporateCustomer">
  <rdfs:subClassOf rdf:resource="#Customer"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对公客户</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以法人或非法人组织身份开户的客户，需核查受益所有人。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InternalOrganization">
  <rdfs:subClassOf rdf:resource="#BankParty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">内部机构</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">银行自身的组织单元，承担经营与管理职责。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#HeadOffice">
  <rdfs:subClassOf rdf:resource="#InternalOrganization"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">总行</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">承担全行管理、政策制定与集中运营职能的机构。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Branch">
  <rdfs:subClassOf rdf:resource="#InternalOrganization"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">分支机构</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">在总行授权下开展属地经营活动的机构。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Employee">
  <rdfs:subClassOf rdf:resource="#BankParty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">员工</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">与银行建立劳动关系、行使系统权限的内部人员。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ExternalPartner">
  <rdfs:subClassOf rdf:resource="#BankParty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">外部合作方</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">与银行存在业务协作关系的第三方机构。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FinancialProduct">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">金融产品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">银行向客户提供的可销售金融服务单元。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DepositProduct">
  <rdfs:subClassOf rdf:resource="#FinancialProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">存款产品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以吸收存款为核心的产品，含活期、定期、大额存单等。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LoanProduct">
  <rdfs:subClassOf rdf:resource="#FinancialProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款产品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以资金融出为核心的产品，含流动资金贷款、项目贷款、消费贷款等。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#WealthManagementProduct">
  <rdfs:subClassOf rdf:resource="#FinancialProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">理财产品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受资管新规约束的代客理财与财富管理产品。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SettlementService">
  <rdfs:subClassOf rdf:resource="#FinancialProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">支付结算服务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">为客户提供的资金收付与清算服务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IntermediaryBusiness">
  <rdfs:subClassOf rdf:resource="#FinancialProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">中间业务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">不构成表内资产负债、以手续费收入为主的业务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Contract">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">合约</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">银行与客户之间确立权利义务关系的法律文件与账户载体。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Account">
  <rdfs:subClassOf rdf:resource="#Contract"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账户</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">记录客户资金与产品持有状态的合约载体。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DepositAccount">
  <rdfs:subClassOf rdf:resource="#Account"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#appliesProduct"/>
      <owl:someValuesFrom rdf:resource="#DepositProduct"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">存款账户</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">承载存款产品的账户。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LoanAccount">
  <rdfs:subClassOf rdf:resource="#Account"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#appliesProduct"/>
      <owl:someValuesFrom rdf:resource="#LoanProduct"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款账户</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">承载贷款产品额度与还款状态的账户。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SettlementAccount">
  <rdfs:subClassOf rdf:resource="#Account"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">结算账户</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">用于资金收付与清算的账户。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Agreement">
  <rdfs:subClassOf rdf:resource="#Contract"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">协议</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">约定服务条款与费用安排的书面或电子合约。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FinancialTransaction">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#viaChannel"/>
      <owl:someValuesFrom rdf:resource="#ServiceChannel"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">金融交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">引起资金或权利义务变动的业务事件。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DepositTransaction">
  <rdfs:subClassOf rdf:resource="#FinancialTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">存款交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资金存入账户的交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#WithdrawalTransaction">
  <rdfs:subClassOf rdf:resource="#FinancialTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">取款交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资金从账户付出的交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TransferTransaction">
  <rdfs:subClassOf rdf:resource="#FinancialTransaction"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#involvesAccount"/>
      <owl:onClass rdf:resource="#Account"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">转账交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账户之间资金转移的交易，至少涉及两个账户。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PaymentTransaction">
  <rdfs:subClassOf rdf:resource="#FinancialTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">支付交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">向收款方完成资金支付义务的交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ClearingTransaction">
  <rdfs:subClassOf rdf:resource="#FinancialTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">清算交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">机构之间完成资金与债权债务了结的交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CashTransaction">
  <rdfs:subClassOf rdf:resource="#FinancialTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">现金交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以实物现金收付完成的交易，需登记券别与柜员。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CardTransaction">
  <rdfs:subClassOf rdf:resource="#FinancialTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">银行卡交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">通过银行卡介质发起的交易，涉及商户与受理终端。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CardPurchaseTransaction">
  <rdfs:subClassOf rdf:resource="#CardTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">卡消费交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">持卡人在商户完成消费支付的交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CardCashWithdrawalTransaction">
  <rdfs:subClassOf rdf:resource="#CardTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">卡取现交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">持卡人通过 ATM 或柜面提取现金的交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CardRefundTransaction">
  <rdfs:subClassOf rdf:resource="#CardTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">卡退货交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对已发生消费交易的全部或部分冲正退款。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ForeignExchangeTransaction">
  <rdfs:subClassOf rdf:resource="#FinancialTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">外汇买卖交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">两种币种之间按汇率兑换的交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FXSpotTransaction">
  <rdfs:subClassOf rdf:resource="#ForeignExchangeTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">即期外汇交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">成交后两个工作日内完成交割的外汇买卖。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FXForwardTransaction">
  <rdfs:subClassOf rdf:resource="#ForeignExchangeTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">远期外汇交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">约定未来日期与汇率交割的外汇买卖。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FXSwapTransaction">
  <rdfs:subClassOf rdf:resource="#ForeignExchangeTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">外汇掉期交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">两笔币种相同、方向相反、交割日不同的外汇买卖组合。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BillTransaction">
  <rdfs:subClassOf rdf:resource="#FinancialTransaction"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#involvesBill"/>
      <owl:someValuesFrom rdf:resource="#Bill"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">围绕票据权利义务变动办理的交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BillAcceptanceTransaction">
  <rdfs:subClassOf rdf:resource="#BillTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据承兑交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">承兑人承诺到期付款的票据行为。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BillDiscountTransaction">
  <rdfs:subClassOf rdf:resource="#BillTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据贴现交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">持票人将未到期票据转让给银行换取资金。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BillRediscountTransaction">
  <rdfs:subClassOf rdf:resource="#BillTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">转贴现与再贴现交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">银行间转让票据或向央行贴现的交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BillSettlementTransaction">
  <rdfs:subClassOf rdf:resource="#BillTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据到期付款交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据到期时由承兑人完成付款了结。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InvestmentTransaction">
  <rdfs:subClassOf rdf:resource="#FinancialTransaction"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#involvesInvestmentProduct"/>
      <owl:someValuesFrom rdf:resource="#WealthManagementProduct"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">投资理财交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">围绕理财产品与投资品种的认购与赎回交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#WealthSubscriptionTransaction">
  <rdfs:subClassOf rdf:resource="#InvestmentTransaction"/>
  <owl:disjointWith rdf:resource="#WealthRedemptionTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">理财认购交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户申购理财产品份额的交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#WealthRedemptionTransaction">
  <rdfs:subClassOf rdf:resource="#InvestmentTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">理财赎回交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户赎回理财产品份额的交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FeeTransaction">
  <rdfs:subClassOf rdf:resource="#FinancialTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">收费与计息交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">因服务收费或资金计息引发的资金变动。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FeeChargeTransaction">
  <rdfs:subClassOf rdf:resource="#FeeTransaction"/>
  <owl:disjointWith rdf:resource="#InterestSettlementTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">手续费收取交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按价目表收取服务费用的交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InterestSettlementTransaction">
  <rdfs:subClassOf rdf:resource="#FeeTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">利息结算交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">存款结息或贷款收息的资金结算。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CrossBorderTransaction">
  <rdfs:subClassOf rdf:resource="#FinancialTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">跨境交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资金跨越国境收付的交易，须履行国际收支申报与制裁筛查。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InwardRemittanceTransaction">
  <rdfs:subClassOf rdf:resource="#CrossBorderTransaction"/>
  <owl:disjointWith rdf:resource="#OutwardRemittanceTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">汇入汇款交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资金由境外汇入境内的汇款交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#OutwardRemittanceTransaction">
  <rdfs:subClassOf rdf:resource="#CrossBorderTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">汇出汇款交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资金由境内汇往境外的汇款交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AgencyTransaction">
  <rdfs:subClassOf rdf:resource="#FinancialTransaction"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#underAgreement"/>
      <owl:someValuesFrom rdf:resource="#AgencyAgreement"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">代收付与批量交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受委托单位委托批量办理的收付款交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AgencyCollectionTransaction">
  <rdfs:subClassOf rdf:resource="#AgencyTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">委托代收交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受委托向付款方收取款项的交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AgencyPaymentTransaction">
  <rdfs:subClassOf rdf:resource="#AgencyTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">委托代付交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受委托向收款方支付款项的交易。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BatchDebitTransaction">
  <rdfs:subClassOf rdf:resource="#AgencyTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">批量代扣交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按委托协议批量从多个账户扣收款项。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BatchCreditTransaction">
  <rdfs:subClassOf rdf:resource="#AgencyTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">批量代发交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按委托协议批量向多个账户发放款项。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AgencyAgreement">
  <rdfs:subClassOf rdf:resource="#Agreement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">委托代收付协议</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">银行与委托单位约定批量收付款权利义务的协议。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CorrespondentBank">
  <rdfs:subClassOf rdf:resource="#ExternalPartner"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">代理行</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">为本行跨境清算提供账户与通道服务的境外同业机构。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ServiceChannel">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">服务渠道</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户触达银行服务的通路。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CounterChannel">
  <rdfs:subClassOf rdf:resource="#ServiceChannel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">柜面渠道</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">通过网点柜员人工办理业务的渠道。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InternetBankingChannel">
  <rdfs:subClassOf rdf:resource="#ServiceChannel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">网上银行渠道</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">通过浏览器访问的电子银行渠道。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MobileBankingChannel">
  <rdfs:subClassOf rdf:resource="#ServiceChannel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">手机银行渠道</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">通过移动端应用访问的电子银行渠道。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SelfServiceChannel">
  <rdfs:subClassOf rdf:resource="#ServiceChannel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">自助渠道</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">自助终端与智能柜台等无人值守渠道。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#OpenApiChannel">
  <rdfs:subClassOf rdf:resource="#ServiceChannel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">开放银行API渠道</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">通过标准化接口向合作方开放能力的渠道。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RiskAndCompliance">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险与合规</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险控制与合规管理领域的对象集合。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RiskEvent">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险事件</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已识别或已发生的信用、市场、操作、流动性等风险事件。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ComplianceRequirement">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">合规要求</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">法律法规、监管规定与内部制度提出的约束性要求。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RegulatoryReport">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#submittedTo"/>
      <owl:someValuesFrom rdf:resource="#RegulatoryBody"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#submittedBy"/>
      <owl:someValuesFrom rdf:resource="#InternalOrganization"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#inBatch"/>
      <owl:someValuesFrom rdf:resource="#ReportingBatch"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#producedFrom"/>
      <owl:someValuesFrom rdf:resource="#DataSet"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">监管报送</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按监管口径定期或不定期报送的数据与报表。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AuditRecord">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#signedWith"/>
      <owl:someValuesFrom rdf:resource="#AsymmetricAlgorithm"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">审计记录</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">记录关键操作与审批轨迹、不可抵赖的留痕数据。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SecurityDomain">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">安全域</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">身份、权限与密码学相关的安全对象集合。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Role">
  <rdfs:subClassOf rdf:resource="#SecurityDomain"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">角色</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">权限分配的逻辑集合，是 RBAC 授权模型的核心。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SystemAdministrationRole">
  <rdfs:subClassOf rdf:resource="#Role"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">系统管理权角色</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">掌握系统配置、参数与账号管理权限的角色。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BusinessOperationRole">
  <rdfs:subClassOf rdf:resource="#Role"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">业务操作权角色</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">掌握业务办理与交易操作权限的角色。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AuditRole">
  <rdfs:subClassOf rdf:resource="#Role"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">审计权角色</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">掌握日志审计与行为追溯权限的角色。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SupervisionRole">
  <rdfs:subClassOf rdf:resource="#Role"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">监督权角色</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">掌握合规监督与风险监控权限的角色。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Permission">
  <rdfs:subClassOf rdf:resource="#SecurityDomain"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">权限</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对系统功能或数据对象的具体操作许可。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CryptographicKey">
  <rdfs:subClassOf rdf:resource="#SecurityDomain"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">密钥</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">用于加密、签名与完整性保护的密钥材料。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CryptoAlgorithm">
  <rdfs:subClassOf rdf:resource="#SecurityDomain"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">密码算法</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">实现机密性、完整性与不可否认性的算法。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SymmetricAlgorithm">
  <rdfs:subClassOf rdf:resource="#CryptoAlgorithm"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对称算法</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">加解密使用相同密钥的算法，如 SM4、AES。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AsymmetricAlgorithm">
  <rdfs:subClassOf rdf:resource="#CryptoAlgorithm"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">非对称算法</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">使用公私钥对的算法，如 SM2、RSA。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#HashAlgorithm">
  <rdfs:subClassOf rdf:resource="#CryptoAlgorithm"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">摘要算法</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">生成定长摘要用于完整性校验的算法，如 SM3。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SecurityPolicy">
  <rdfs:subClassOf rdf:resource="#SecurityDomain"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">安全策略</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">约束系统行为的成文安全规则集合。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TechnicalComponent">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">技术组件</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">支撑业务运行的基础技术设施与公共服务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CryptoService">
  <rdfs:subClassOf rdf:resource="#TechnicalComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">加密服务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">提供密钥管理与密码运算的统一服务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FileTransferService">
  <rdfs:subClassOf rdf:resource="#TechnicalComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">文件传输服务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">提供跨系统可靠文件交换的服务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MessageQueue">
  <rdfs:subClassOf rdf:resource="#TechnicalComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">消息中间件</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">提供异步解耦与可靠投递的消息服务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LoggingService">
  <rdfs:subClassOf rdf:resource="#TechnicalComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">日志服务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">统一采集与留存系统运行与操作日志。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MonitoringService">
  <rdfs:subClassOf rdf:resource="#TechnicalComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">监控服务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">采集指标、告警与健康状况的服务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SchedulingService">
  <rdfs:subClassOf rdf:resource="#TechnicalComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">调度服务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">统一编排批处理与定时任务的服务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DataAsset">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据资产</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">银行经营过程中产生与沉淀的数据对象。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DataEntity">
  <rdfs:subClassOf rdf:resource="#DataAsset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据实体</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">经过建模的业务数据对象，构成数据模型的基本单元。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DataSet">
  <rdfs:subClassOf rdf:resource="#DataAsset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据集</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">面向特定用途组织的数据实体集合。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BusinessMetric">
  <rdfs:subClassOf rdf:resource="#DataAsset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">业务指标</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">口径明确、可度量的经营与管理指标。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RegulatoryBody">
  <rdfs:subClassOf rdf:resource="#ExternalPartner"/>
  <owl:disjointWith rdf:resource="#CorrespondentBank"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">监管机构</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">依法对银行实施监督管理职能的机构。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ReportingStatus">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送状态</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">监管报送所处的生命周期状态。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ReportingBatch">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送批次</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同一报送任务下一次性提交的一组报文。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ReportingTask">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送任务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按监管要求组织报文编制、复核与提交的工作单元。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ReportingDataItem">
  <rdfs:subClassOf rdf:resource="#DataEntity"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#governedByRule"/>
      <owl:someValuesFrom rdf:resource="#ReportingRule"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送数据项</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">监管口径下明确定义的最小报送字段。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ReportingRule">
  <rdfs:subClassOf rdf:resource="#ComplianceRequirement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送校验规则</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报文须满足的口径、勾稽与校验约束。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EASTReport">
  <rdfs:subClassOf rdf:resource="#RegulatoryReport"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasDataItem"/>
      <owl:someValuesFrom rdf:resource="#EASTDataItem"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EAST 报送</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">监管数据标准化报送，覆盖表内外业务明细数据。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#StatutoryReport1104">
  <rdfs:subClassOf rdf:resource="#RegulatoryReport"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1104 非现场监管报表</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">向金融监管部门报送的非现场监管报表系列。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AMLReport">
  <rdfs:subClassOf rdf:resource="#RegulatoryReport"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasDataItem"/>
      <owl:onClass rdf:resource="#ReportingDataItem"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">反洗钱报送</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">大额交易与可疑交易等反洗钱报送。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CreditRegistryReport">
  <rdfs:subClassOf rdf:resource="#RegulatoryReport"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">征信报送</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">向征信系统报送的客户信贷信息。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FinancialStatisticsReport">
  <rdfs:subClassOf rdf:resource="#RegulatoryReport"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">金融统计报送</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">向人民银行报送的全科目金融统计报表。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PaymentSettlementReport">
  <rdfs:subClassOf rdf:resource="#RegulatoryReport"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">支付结算报表</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">支付结算业务相关的监管报表。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CreditRiskEvent">
  <rdfs:subClassOf rdf:resource="#RiskEvent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">信用风险事件</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">因交易对手违约或信用质量下降引发的风险事件。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MarketRiskEvent">
  <rdfs:subClassOf rdf:resource="#RiskEvent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">市场风险事件</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">因市场价格不利变动引发的风险事件。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#OperationalRiskEvent">
  <rdfs:subClassOf rdf:resource="#RiskEvent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">操作风险事件</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">因内部流程、人员、系统缺陷或外部事件引发的风险事件。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LiquidityRiskEvent">
  <rdfs:subClassOf rdf:resource="#RiskEvent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">流动性风险事件</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">因资金错配或融资能力不足引发的风险事件。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ComplianceRiskEvent">
  <rdfs:subClassOf rdf:resource="#RiskEvent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">合规风险事件</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">因违反法律法规或监管规定引发的风险事件。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EASTDataItem">
  <rdfs:subClassOf rdf:resource="#ReportingDataItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EAST 数据项</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">监管数据标准化（EAST）报送口径下的数据项。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EASTCustomerItem">
  <rdfs:subClassOf rdf:resource="#EASTDataItem"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#reportsEntity"/>
      <owl:someValuesFrom rdf:resource="#Customer"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户主题域数据项</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EAST 客户信息主题的报送字段集合。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EASTAccountItem">
  <rdfs:subClassOf rdf:resource="#EASTDataItem"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#reportsEntity"/>
      <owl:someValuesFrom rdf:resource="#Account"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账户主题域数据项</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EAST 账户信息主题的报送字段集合。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EASTDepositItem">
  <rdfs:subClassOf rdf:resource="#EASTDataItem"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#reportsEntity"/>
      <owl:someValuesFrom rdf:resource="#DepositAccount"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">存款主题域数据项</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EAST 存款业务主题的报送字段集合。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EASTLoanItem">
  <rdfs:subClassOf rdf:resource="#EASTDataItem"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#reportsEntity"/>
      <owl:someValuesFrom rdf:resource="#LoanAccount"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款主题域数据项</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EAST 信贷管理主题的报送字段集合。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EASTTransactionItem">
  <rdfs:subClassOf rdf:resource="#EASTDataItem"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#reportsEntity"/>
      <owl:someValuesFrom rdf:resource="#FinancialTransaction"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易主题域数据项</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EAST 交易流水主题的报送字段集合。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EASTBillItem">
  <rdfs:subClassOf rdf:resource="#EASTDataItem"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#reportsEntity"/>
      <owl:someValuesFrom rdf:resource="#Bill"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据主题域数据项</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EAST 票据业务主题的报送字段集合，覆盖承兑、贴现、转贴现与再贴现。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EASTInterbankItem">
  <rdfs:subClassOf rdf:resource="#EASTDataItem"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#reportsEntity"/>
      <owl:someValuesFrom rdf:resource="#InterbankBusiness"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业主题域数据项</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EAST 同业业务主题的报送字段集合，覆盖拆借、存放、买入返售与同业存单。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EASTWealthItem">
  <rdfs:subClassOf rdf:resource="#EASTDataItem"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#reportsEntity"/>
      <owl:someValuesFrom rdf:resource="#WealthManagementProduct"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">理财主题域数据项</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EAST 理财业务主题的报送字段集合，覆盖产品募集、净值与客户持有。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EASTOffBalanceItem">
  <rdfs:subClassOf rdf:resource="#EASTDataItem"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#reportsEntity"/>
      <owl:someValuesFrom rdf:resource="#OffBalanceCommitment"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外主题域数据项</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EAST 表外业务主题的报送字段集合，覆盖保函、信用证、承诺与衍生品。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Bill">
  <rdfs:subClassOf rdf:resource="#Contract"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以无条件支付确定金额为标的的有价凭证。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BankAcceptanceBill">
  <rdfs:subClassOf rdf:resource="#Bill"/>
  <owl:disjointWith rdf:resource="#CommercialAcceptanceBill"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">银行承兑汇票</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">由银行承担到期付款责任的汇票，同时构成表外承兑承担。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CommercialAcceptanceBill">
  <rdfs:subClassOf rdf:resource="#Bill"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">商业承兑汇票</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">由银行以外的付款人承兑的汇票。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InterbankBusiness">
  <rdfs:subClassOf rdf:resource="#Contract"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业业务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">银行与其他金融机构之间开展资金融通与往来的业务合约。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InterbankLending">
  <rdfs:subClassOf rdf:resource="#InterbankBusiness"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业拆借</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">金融机构之间的短期无担保资金融通。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InterbankDeposit">
  <rdfs:subClassOf rdf:resource="#InterbankBusiness"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业存放</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">金融机构之间以存放形式开展的资金往来。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ReverseRepo">
  <rdfs:subClassOf rdf:resource="#InterbankBusiness"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">买入返售</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以买入并约定返售方式开展的资金融出业务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InterbankCD">
  <rdfs:subClassOf rdf:resource="#InterbankBusiness"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">同业存单</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">存款类金融机构发行的记账式定期存款凭证。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#OffBalanceCommitment">
  <rdfs:subClassOf rdf:resource="#Contract"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外承担</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">不列入资产负债表但形成或有权利义务的业务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Guarantee">
  <rdfs:subClassOf rdf:resource="#OffBalanceCommitment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">保函</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">银行应申请人要求向受益人出具的付款保证。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LetterOfCredit">
  <rdfs:subClassOf rdf:resource="#OffBalanceCommitment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">信用证</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">银行依申请开立的有条件付款承诺凭证。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AcceptanceCommitment">
  <rdfs:subClassOf rdf:resource="#OffBalanceCommitment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">承兑承诺</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">银行对汇票承兑所形成的或有付款义务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CreditCommitment">
  <rdfs:subClassOf rdf:resource="#OffBalanceCommitment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款承诺</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">银行承诺在未来按约定条件提供信贷的安排。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DerivativeContract">
  <rdfs:subClassOf rdf:resource="#OffBalanceCommitment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">衍生品合约</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">价值依附于基础资产或指数的金融合约。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SeparationOfDutyViolation">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">职责分离违规</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">由 SWRL 规则推导得出：同一主体被赋予存在职责分离约束的两个角色，或同时承担互斥的岗位职责。SWRL 是单调的，只能标记不能阻止，真正的强制须在 RBAC 授权服务层实现。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DemandDepositProduct">
  <rdfs:subClassOf rdf:resource="#DepositProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">活期存款产品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">无固定期限、可随时存取的存款产品。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TimeDepositProduct">
  <rdfs:subClassOf rdf:resource="#DepositProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">定期存款产品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">约定存期与利率、到期支取的存款产品。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LargeCDProduct">
  <rdfs:subClassOf rdf:resource="#DepositProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">大额存单产品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">面向特定对象发行、可转让的标准化定期存款凭证。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#WorkingCapitalLoanProduct">
  <rdfs:subClassOf rdf:resource="#LoanProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">流动资金贷款</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">满足企业日常经营周转需要的贷款产品。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ProjectLoanProduct">
  <rdfs:subClassOf rdf:resource="#LoanProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">项目贷款</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">针对特定建设项目发放、以项目收益偿还的贷款产品。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ConsumerLoanProduct">
  <rdfs:subClassOf rdf:resource="#LoanProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">消费贷款</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">面向个人消费用途发放的贷款产品。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MortgageLoanProduct">
  <rdfs:subClassOf rdf:resource="#LoanProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按揭贷款</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以所购资产抵押、分期偿还的贷款产品。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AgencyBusiness">
  <rdfs:subClassOf rdf:resource="#IntermediaryBusiness"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">代理业务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">代客户办理收付、代销等代理类中间业务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GuaranteeBusiness">
  <rdfs:subClassOf rdf:resource="#IntermediaryBusiness"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保类中间业务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以银行信用提供担保并收取手续费的中间业务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CommitmentBusiness">
  <rdfs:subClassOf rdf:resource="#IntermediaryBusiness"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">承诺类中间业务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">形成或有债权债务承诺的中间业务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TradingAgencyBusiness">
  <rdfs:subClassOf rdf:resource="#IntermediaryBusiness"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易类中间业务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">代理客户进行金融工具交易的中间业务。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Collateral">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">押品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">为担保债权实现而设定担保权利的财产或权利。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CashCollateral">
  <rdfs:subClassOf rdf:resource="#Collateral"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">现金类押品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">保证金、存单等现金及现金等价物形态的押品。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RealEstateCollateral">
  <rdfs:subClassOf rdf:resource="#Collateral"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">不动产押品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">土地使用权、房屋建筑物等不动产形态的押品。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ReceivablesCollateral">
  <rdfs:subClassOf rdf:resource="#Collateral"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">应收账款押品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以应收账款债权设定的押品。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SecuritiesCollateral">
  <rdfs:subClassOf rdf:resource="#Collateral"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">有价证券押品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以股票、债券、基金份额等有价证券设定的押品。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MovableCollateral">
  <rdfs:subClassOf rdf:resource="#Collateral"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">动产押品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">机器设备、存货、车辆等动产形态的押品。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BeneficialOwner">
  <rdfs:subClassOf rdf:resource="#BankParty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受益所有人</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">最终有效控制或享有法人客户收益的自然人，反洗钱与客户尽职调查的核查对象。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CreditRating">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">信用评级</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对客户或债项偿债能力与违约风险的评价结果。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RiskIndicator">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险指标</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">用于量化监测与预警风险水平的计量指标。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CreditLimit">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">授信额度</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">银行核定的客户可使用的信用敞口上限。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#UserAccount">
  <rdfs:subClassOf rdf:resource="#SecurityDomain"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">系统账号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">员工在信息系统中用于身份鉴别与访问控制的账号凭证。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DatabaseService">
  <rdfs:subClassOf rdf:resource="#TechnicalComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据库服务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">提供数据持久化存储与访问的组件。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#APIGateway">
  <rdfs:subClassOf rdf:resource="#TechnicalComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">API 网关</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">统一对外暴露服务接口并提供鉴权、限流与路由的组件。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CacheService">
  <rdfs:subClassOf rdf:resource="#TechnicalComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">缓存服务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">提供高速数据访问以承载热点读写的组件。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ConfigCenter">
  <rdfs:subClassOf rdf:resource="#TechnicalComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">配置中心</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">集中管理与下发系统配置参数的组件。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DataStandard">
  <rdfs:subClassOf rdf:resource="#DataAsset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据标准</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对数据定义、口径与编码规则的统一约定。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DataModel">
  <rdfs:subClassOf rdf:resource="#DataAsset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据模型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对数据结构、关系与约束的抽象描述。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DataQualityRule">
  <rdfs:subClassOf rdf:resource="#ComplianceRequirement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据质量规则</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据须满足的准确性、完整性与一致性约束。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MappingMetadata">
  <rdfs:subClassOf rdf:resource="#DataAsset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射元数据</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">描述报送口径、本体属性与源系统字段之间对应关系的元数据总称。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MappingSpecification">
  <rdfs:subClassOf rdf:resource="#MappingMetadata"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射规格</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">某一报送口径下一组字段映射条目的集合，按版本管理。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FieldMapping">
  <rdfs:subClassOf rdf:resource="#MappingMetadata"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#inSpecification"/>
      <owl:someValuesFrom rdf:resource="#MappingSpecification"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">字段映射条目</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">三元关系的核心载体：一条报送字段与源表字段（或转换逻辑）的对应关系。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SourceTable">
  <rdfs:subClassOf rdf:resource="#MappingMetadata"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源系统表</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源业务系统中承载报送数据的数据表。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SourceField">
  <rdfs:subClassOf rdf:resource="#MappingMetadata"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#belongsToTable"/>
      <owl:someValuesFrom rdf:resource="#SourceTable"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源表字段</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源系统表中的具体字段。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TransformationRule">
  <rdfs:subClassOf rdf:resource="#MappingMetadata"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">转换规则</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源值到报送值之间的加工逻辑定义。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CodeMapping">
  <rdfs:subClassOf rdf:resource="#MappingMetadata"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">代码转换表</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源系统代码值与监管口径代码值的对照条目。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MappingCoverage">
  <rdfs:subClassOf rdf:resource="#MappingMetadata"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射覆盖率快照</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">某时点映射完备程度的度量结果，供校验与追踪。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SubBranch">
  <rdfs:subClassOf rdf:resource="#Branch"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">支行</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">隶属于分行、直接面向客户经营的机构。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Outlet">
  <rdfs:subClassOf rdf:resource="#SubBranch"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">营业网点</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对外办理柜面业务的物理场所。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Department">
  <rdfs:subClassOf rdf:resource="#InternalOrganization"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">内设部门</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">机构内部按职能划分的组织单元，如公司金融部、风险管理部。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Position">
  <rdfs:subClassOf rdf:resource="#BankParty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">岗位</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">组织内承担特定职责与权限的位置，是 RBAC 赋权与职责分离的载体。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Accounting">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">会计账务域</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以复式记账为基础记录、归集与反映银行经济事项的领域。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AccountingSubject">
  <rdfs:subClassOf rdf:resource="#Accounting"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">会计科目</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对会计要素进行分类核算的科目，是账务处理的基础。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AssetSubject">
  <rdfs:subClassOf rdf:resource="#AccountingSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资产类科目</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">反映银行拥有或控制的资源的科目。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LiabilitySubject">
  <rdfs:subClassOf rdf:resource="#AccountingSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">负债类科目</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">反映银行所承担债务的科目。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EquitySubject">
  <rdfs:subClassOf rdf:resource="#AccountingSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">所有者权益类科目</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">反映所有者对净资产享有权益的科目。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IncomeSubject">
  <rdfs:subClassOf rdf:resource="#AccountingSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">损益类收入科目</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">反映经营成果中收入部分的科目。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ExpenseSubject">
  <rdfs:subClassOf rdf:resource="#AccountingSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">损益类支出科目</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">反映经营成果中支出部分的科目。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#OffBalanceSubject">
  <rdfs:subClassOf rdf:resource="#AccountingSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">表外科目</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">核算不在资产负债表内反映但需登记的或有事项科目。刻意不参与科目互斥——表外事项可能同时具备或有资产与或有负债性质。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AccountingVoucher">
  <rdfs:subClassOf rdf:resource="#Accounting"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#inPeriod"/>
      <owl:someValuesFrom rdf:resource="#AccountingPeriod"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">记账凭证</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">载明经济事项并据以登记账簿的书面记录。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AccountingEntry">
  <rdfs:subClassOf rdf:resource="#Accounting"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#debitSubject"/>
      <owl:someValuesFrom rdf:resource="#AccountingSubject"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#creditSubject"/>
      <owl:someValuesFrom rdf:resource="#AccountingSubject"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#inVoucher"/>
      <owl:someValuesFrom rdf:resource="#AccountingVoucher"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">会计分录</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按复式记账规则记录一笔经济事项借贷双方的账务单元。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Ledger">
  <rdfs:subClassOf rdf:resource="#Accounting"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账簿</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按既定口径登记账务记录的簿籍，是总账与分户账的共同父类。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GeneralLedger">
  <rdfs:subClassOf rdf:resource="#Ledger"/>
  <owl:disjointWith rdf:resource="#SubLedger"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#subjectOfLedger"/>
      <owl:someValuesFrom rdf:resource="#AccountingSubject"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">总账</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按会计科目汇总登记的账簿。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SubLedger">
  <rdfs:subClassOf rdf:resource="#Ledger"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#ledgerOfAccount"/>
      <owl:someValuesFrom rdf:resource="#Account"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">分户账</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按账户或客户明细登记的账簿，与总账勾稽。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AccountingPeriod">
  <rdfs:subClassOf rdf:resource="#Accounting"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">会计期间</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">进行账务核算与结账的时间区间。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Guarantor">
  <rdfs:subClassOf rdf:resource="#BankParty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保人</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">为债务人履行债务提供担保的自然人或法人。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CorporateGuarantor">
  <rdfs:subClassOf rdf:resource="#Guarantor"/>
  <owl:disjointWith rdf:resource="#PersonalGuarantor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">法人担保人</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以法人或非法人组织身份提供担保的主体。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PersonalGuarantor">
  <rdfs:subClassOf rdf:resource="#Guarantor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">自然人担保人</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以自然人身份提供担保的主体。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GuaranteeContract">
  <rdfs:subClassOf rdf:resource="#Agreement"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#underGuarantee"/>
      <owl:someValuesFrom rdf:resource="#Contract"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保合同</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">约定担保权利义务的从合同，依附于主债权合同。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SuretyshipContract">
  <rdfs:subClassOf rdf:resource="#GuaranteeContract"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">保证合同</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以保证人信用提供担保的合同，不涉及特定押品。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MortgageContract">
  <rdfs:subClassOf rdf:resource="#GuaranteeContract"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#secures"/>
      <owl:someValuesFrom rdf:resource="#Collateral"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">抵押合同</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以不动产等抵押物提供担保的合同，抵押物不转移占有。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PledgeContract">
  <rdfs:subClassOf rdf:resource="#GuaranteeContract"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#secures"/>
      <owl:someValuesFrom rdf:resource="#Collateral"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">质押合同</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">以动产或权利凭证提供担保的合同，质押物转移占有。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PricingDomain">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">定价域</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">金额、利率与费用的确定规则与计量口径。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InterestRate">
  <rdfs:subClassOf rdf:resource="#PricingDomain"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">利率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资金使用的价格，按期限、币种与计息方式确定。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BenchmarkRate">
  <rdfs:subClassOf rdf:resource="#InterestRate"/>
  <owl:disjointWith rdf:resource="#ExecutingRate"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">基准利率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">由市场或官方公布的参考利率，如 LPR、Shibor。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ExecutingRate">
  <rdfs:subClassOf rdf:resource="#InterestRate"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">执行利率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">在基准利率基础上加减点后实际适用于具体业务的利率。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FeeItem">
  <rdfs:subClassOf rdf:resource="#PricingDomain"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">收费项目</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对特定服务收取费用的项目定义。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FeeSchedule">
  <rdfs:subClassOf rdf:resource="#PricingDomain"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">价目表</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按版本管理的收费项目与费率集合。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CustomerRiskLevel">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户风险等级</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">反洗钱口径下对客户洗钱与恐怖融资风险的评级结果。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DueDiligence">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">尽职调查</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">为客户身份识别与风险评估所开展的核查活动。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SimplifiedDueDiligence">
  <rdfs:subClassOf rdf:resource="#DueDiligence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">简化尽职调查</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对低风险客户采取的简化核查措施。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#StandardDueDiligence">
  <rdfs:subClassOf rdf:resource="#DueDiligence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">标准尽职调查</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对一般风险客户采取的常规核查措施。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EnhancedDueDiligence">
  <rdfs:subClassOf rdf:resource="#DueDiligence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">加强尽职调查</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对高风险客户、政要或高风险地域采取的强化核查措施。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SuspiciousTransactionReport">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#reportsEntity"/>
      <owl:someValuesFrom rdf:resource="#FinancialTransaction"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">可疑交易报告</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">发现可疑情形后向反洗钱监测中心报送的报告。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LargeAmountTransactionReport">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#reportsEntity"/>
      <owl:someValuesFrom rdf:resource="#FinancialTransaction"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">大额交易报告</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">达到规定金额门槛后报送的交易报告。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SanctionsScreening">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">制裁名单筛查</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对客户或交易对手开展制裁与恐怖分子名单的比对筛查。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Exposure">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险敞口</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">在不利事件下可能承受损失的暴露金额。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CreditExposure">
  <rdfs:subClassOf rdf:resource="#Exposure"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">信用风险敞口</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">因交易对手违约可能形成的风险暴露。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MarketExposure">
  <rdfs:subClassOf rdf:resource="#Exposure"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">市场风险敞口</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">因市场价格不利变动可能形成的风险暴露。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#OperationalExposure">
  <rdfs:subClassOf rdf:resource="#Exposure"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">操作风险敞口</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">因内部流程、人员或系统缺陷可能形成的风险暴露。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RiskWeightedAsset">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险加权资产</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按风险权重折算后的资产额，是资本充足率的分母。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Provision">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">拨备</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">为抵补预期损失而计提的准备金。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LoanLossProvision">
  <rdfs:subClassOf rdf:resource="#Provision"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款损失准备</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">针对贷款资产计提的损失准备金。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Impairment">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#impairs"/>
      <owl:someValuesFrom rdf:resource="#LoanAccount"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">减值</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按预期信用损失模型确认的资产价值减损。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CapitalAdequacy">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#basedOnRWA"/>
      <owl:someValuesFrom rdf:resource="#RiskWeightedAsset"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资本充足率计量</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资本与风险加权资产的比率测算，含各级资本构成。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RiskMitigation">
  <rdfs:subClassOf rdf:resource="#RiskAndCompliance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险缓释</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">通过押品、保证或净额结算等手段降低风险暴露的安排。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BankOperation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">运营域</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">支撑账务处理、清算与日常运行的作业活动。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BatchJob">
  <rdfs:subClassOf rdf:resource="#BankOperation"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#executedOn"/>
      <owl:someValuesFrom rdf:resource="#TechnicalComponent"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">批处理作业</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按计划批量执行的作业，如日终结息、批量代扣、报表加工。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Reconciliation">
  <rdfs:subClassOf rdf:resource="#BankOperation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对账</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">两个或多个账务记录之间的核对作业，用于发现差异。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#OperationalError">
  <rdfs:subClassOf rdf:resource="#BankOperation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">运营差错</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">业务处理过程中发生的需更正的错误记录。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SettlementSession">
  <rdfs:subClassOf rdf:resource="#BankOperation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">清算场次</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">支付系统在规定时点集中完成资金了结的场次。</rdfs:comment>
</owl:Class>

<owl:NamedIndividual rdf:about="#RoleSystemAdmin">
  <rdf:type rdf:resource="#SystemAdministrationRole"/>
  <separatedFrom rdf:resource="#RoleBusinessOperator"/>
  <separatedFrom rdf:resource="#RoleAuditor"/>
  <separatedFrom rdf:resource="#RoleSupervisor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">系统管理员</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">持有系统管理权的角色实例。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RoleBusinessOperator">
  <rdf:type rdf:resource="#BusinessOperationRole"/>
  <separatedFrom rdf:resource="#RoleAuditor"/>
  <separatedFrom rdf:resource="#RoleSupervisor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">业务操作员</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">持有业务操作权的角色实例。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RoleAuditor">
  <rdf:type rdf:resource="#AuditRole"/>
  <separatedFrom rdf:resource="#RoleSupervisor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">审计员</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">持有审计权的角色实例。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RoleSupervisor">
  <rdf:type rdf:resource="#SupervisionRole"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">监督员</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">持有监督权的角色实例。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SM2">
  <rdf:type rdf:resource="#AsymmetricAlgorithm"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SM2 椭圆曲线公钥算法</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">国密非对称算法，用于数字签名与密钥交换。</rdfs:comment>
  <algorithmName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SM2</algorithmName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SM3">
  <rdf:type rdf:resource="#HashAlgorithm"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SM3 密码杂凑算法</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">国密摘要算法，用于完整性校验。</rdfs:comment>
  <algorithmName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SM3</algorithmName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SM4">
  <rdf:type rdf:resource="#SymmetricAlgorithm"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SM4 分组密码算法</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">国密对称算法，用于数据加密。</rdfs:comment>
  <algorithmName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SM4</algorithmName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RSA">
  <rdf:type rdf:resource="#AsymmetricAlgorithm"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RSA 公钥算法</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">国际通用非对称算法，用于兼容场景。</rdfs:comment>
  <algorithmName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RSA</algorithmName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AES">
  <rdf:type rdf:resource="#SymmetricAlgorithm"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AES 分组密码算法</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">国际通用对称算法，用于兼容场景。</rdfs:comment>
  <algorithmName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AES</algorithmName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ChannelCounter">
  <rdf:type rdf:resource="#CounterChannel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">柜面</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">网点柜面服务渠道实例。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ChannelInternet">
  <rdf:type rdf:resource="#InternetBankingChannel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">网上银行</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">网上银行渠道实例。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ChannelMobile">
  <rdf:type rdf:resource="#MobileBankingChannel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">手机银行</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">手机银行渠道实例。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ChannelOpenApi">
  <rdf:type rdf:resource="#OpenApiChannel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">开放银行接口</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">开放银行 API 渠道实例。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ComponentCrypto">
  <rdf:type rdf:resource="#CryptoService"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">加密与密钥管理平台</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INFR-01 CRYPTO 平台实例。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ComponentFileTransfer">
  <rdf:type rdf:resource="#FileTransferService"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">统一文件传输平台</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INFR-02 FS 平台实例。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ComponentMessageQueue">
  <rdf:type rdf:resource="#MessageQueue"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">消息中间件平台</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INFR-03 MQ 平台实例。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PBOC">
  <rdf:type rdf:resource="#RegulatoryBody"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">中国人民银行</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">负责货币政策、金融统计与征信管理的监管机构。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#NFRA">
  <rdf:type rdf:resource="#RegulatoryBody"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">国家金融监督管理总局</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">负责银行业保险业监督管理的机构。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SAFE">
  <rdf:type rdf:resource="#RegulatoryBody"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">国家外汇管理局</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">负责外汇收支与结售汇监管的机构。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CAMLMAC">
  <rdf:type rdf:resource="#RegulatoryBody"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">中国反洗钱监测分析中心</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">接收大额与可疑交易报告的机构。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#StatusDraft">
  <rdf:type rdf:resource="#ReportingStatus"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">待编制</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报文尚未开始编制。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#StatusCompiled">
  <rdf:type rdf:resource="#ReportingStatus"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已编制</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报文数据已生成，待复核。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#StatusSubmitted">
  <rdf:type rdf:resource="#ReportingStatus"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已提交</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报文已报送至监管机构。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#StatusAccepted">
  <rdf:type rdf:resource="#ReportingStatus"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已受理</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">监管机构已接收并认可报文。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#StatusRejected">
  <rdf:type rdf:resource="#ReportingStatus"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已退回</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报文未通过校验被退回。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#StatusCorrected">
  <rdf:type rdf:resource="#ReportingStatus"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已订正</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">退回后完成订正并重新提交。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RuleCustomerIdRequired">
  <rdf:type rdf:resource="#ReportingRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户证件必填校验</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户主题域的证件类型与证件号码不得为空。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RuleAmountNonNegative">
  <rdf:type rdf:resource="#ReportingRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">金额非负校验</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">所有金额类字段取值不得为负数。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RuleCurrencyStandard">
  <rdf:type rdf:resource="#ReportingRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">币种规范校验</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">币种字段须符合监管口径或 ISO 4217 代码表。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RuleFiveClassDomain">
  <rdf:type rdf:resource="#ReportingRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">五级分类取值域校验</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">五级分类字段取值须落在五级分类代码表内。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RuleBalanceConsistency">
  <rdf:type rdf:resource="#ReportingRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">余额勾稽校验</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易后余额须等于上笔余额加减本笔交易金额。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RuleAccountCustomerRef">
  <rdf:type rdf:resource="#ReportingRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户引用完整性校验</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账户主题域的客户编号须在客户主题域中存在。</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RuleBillDateOrder">
  <rdf:type rdf:resource="#ReportingRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据日期序校验</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据到期日期不得早于出票日期。</rdfs:comment>
</owl:NamedIndividual>

