<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.bank.example/ontology/bank-enterprise"
         xmlns="http://www.bank.example/ontology/bank-enterprise#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://www.bank.example/ontology/bank-enterprise"/>

<owl:ObjectProperty rdf:about="#holdsAccount">
  <rdfs:domain rdf:resource="#BankParty"/>
  <rdfs:range rdf:resource="#Account"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">持有账户</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">参与方对账户的持有关系。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#signsAgreement">
  <rdfs:domain rdf:resource="#BankParty"/>
  <rdfs:range rdf:resource="#Agreement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">签署协议</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">参与方签署协议的行为关系。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#appliesProduct">
  <rdfs:domain rdf:resource="#Account"/>
  <rdfs:range rdf:resource="#FinancialProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">适用产品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账户所承载的金融产品。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#initiatesTransaction">
  <rdfs:domain rdf:resource="#BankParty"/>
  <rdfs:range rdf:resource="#FinancialTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">发起交易</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">参与方主动发起的交易。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#viaChannel">
  <rdfs:domain rdf:resource="#FinancialTransaction"/>
  <rdfs:range rdf:resource="#ServiceChannel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">经由渠道</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易所使用的服务渠道。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#involvesAccount">
  <rdfs:domain rdf:resource="#FinancialTransaction"/>
  <rdfs:range rdf:resource="#Account"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">涉及账户</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易所影响的账户。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#belongsToOrganization">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Employee"/>
  <rdfs:range rdf:resource="#InternalOrganization"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">隶属机构</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">员工所属的内部机构。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#assignedRole">
  <rdfs:domain rdf:resource="#BankParty"/>
  <rdfs:range rdf:resource="#Role"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">被授予角色</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">参与方被分配的角色。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#grantsPermission">
  <rdfs:domain rdf:resource="#Role"/>
  <rdfs:range rdf:resource="#Permission"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">授予权限</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">角色所包含的权限。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#separatedFrom">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Role"/>
  <rdfs:range rdf:resource="#Role"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">职责分离于</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">四权分离约束：两个角色不得由同一主体同时持有。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasRiskEvent">
  <rdfs:domain rdf:resource="#FinancialTransaction"/>
  <rdfs:range rdf:resource="#RiskEvent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产生风险事件</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易触发或关联的风险事件。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#governedBy">
  <rdfs:domain rdf:resource="#FinancialTransaction"/>
  <rdfs:domain rdf:resource="#TechnicalComponent"/>
  <rdfs:domain rdf:resource="#Account"/>
  <rdfs:range rdf:resource="#ComplianceRequirement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受合规约束</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对象须遵循的合规要求。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#generatesAuditRecord">
  <rdfs:domain rdf:resource="#FinancialTransaction"/>
  <rdfs:range rdf:resource="#AuditRecord"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">生成审计记录</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易产生的不可抵赖审计留痕。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#signedWith">
  <rdfs:domain rdf:resource="#AuditRecord"/>
  <rdfs:range rdf:resource="#CryptoAlgorithm"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">签名算法</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">审计记录所使用的签名算法，满足 AC-9.3 要求。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#protectedBy">
  <rdfs:domain rdf:resource="#FinancialTransaction"/>
  <rdfs:domain rdf:resource="#DataAsset"/>
  <rdfs:range rdf:resource="#CryptoAlgorithm"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受算法保护</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对象所受的密码算法保护。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#usesKey">
  <rdfs:domain rdf:resource="#CryptoAlgorithm"/>
  <rdfs:range rdf:resource="#CryptographicKey"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">使用密钥</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">算法运行所依赖的密钥材料。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#dependsOnComponent">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#TechnicalComponent"/>
  <rdfs:range rdf:resource="#TechnicalComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">依赖组件</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">技术组件之间的依赖，具备传递性。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#derivedFrom">
  <rdfs:domain rdf:resource="#DataSet"/>
  <rdfs:range rdf:resource="#DataEntity"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源自实体</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据集的数据来源实体。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#producesMetric">
  <rdfs:domain rdf:resource="#DataSet"/>
  <rdfs:range rdf:resource="#BusinessMetric"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产出指标</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据集计算得出的业务指标。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#submittedBy">
  <rdfs:domain rdf:resource="#RegulatoryReport"/>
  <rdfs:range rdf:resource="#InternalOrganization"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送主体</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">提交报文的内部机构。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#submittedTo">
  <rdfs:domain rdf:resource="#RegulatoryReport"/>
  <rdfs:range rdf:resource="#RegulatoryBody"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送对象</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报文提交的目标监管机构。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDataItem">
  <rdfs:domain rdf:resource="#RegulatoryReport"/>
  <rdfs:range rdf:resource="#ReportingDataItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">包含数据项</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报文所包含的监管数据项。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#governedByRule">
  <rdfs:domain rdf:resource="#ReportingDataItem"/>
  <rdfs:range rdf:resource="#ReportingRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受校验规则约束</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据项须满足的校验规则。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inBatch">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#RegulatoryReport"/>
  <rdfs:range rdf:resource="#ReportingBatch"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">所属批次</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报文所属的报送批次。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasStatus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#RegulatoryReport"/>
  <rdfs:range rdf:resource="#ReportingStatus"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送状态</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报文当前所处的生命周期状态。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#producedFrom">
  <rdfs:domain rdf:resource="#RegulatoryReport"/>
  <rdfs:range rdf:resource="#DataSet"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产出自数据集</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报文数据的来源数据集。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#reviewsReport">
  <rdfs:domain rdf:resource="#Employee"/>
  <rdfs:range rdf:resource="#RegulatoryReport"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">复核报文</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">复核报文的员工，须与编制人职责分离。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#compilesReport">
  <rdfs:domain rdf:resource="#Employee"/>
  <rdfs:range rdf:resource="#RegulatoryReport"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">编制报文</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">编制报文的员工，须与复核人职责分离。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#containsReport">
  <rdfs:domain rdf:resource="#ReportingBatch"/>
  <rdfs:range rdf:resource="#RegulatoryReport"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">包含报文</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">批次所包含的报文。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#involvesBill">
  <rdfs:domain rdf:resource="#BillTransaction"/>
  <rdfs:range rdf:resource="#Bill"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">涉及票据</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">票据交易所指向的票据凭证。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#involvesInvestmentProduct">
  <rdfs:domain rdf:resource="#InvestmentTransaction"/>
  <rdfs:range rdf:resource="#WealthManagementProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">涉及投资产品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">投资理财交易所认购或赎回的产品。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#underAgreement">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#AgencyTransaction"/>
  <rdfs:range rdf:resource="#AgencyAgreement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">依据委托协议</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">代收付交易所依据的委托协议。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#viaCorrespondentBank">
  <rdfs:domain rdf:resource="#CrossBorderTransaction"/>
  <rdfs:range rdf:resource="#CorrespondentBank"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">经由代理行</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">跨境交易所借用的境外代理行通道。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#reportsEntity">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送源实体</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">报送记录所指向的业务实体。刻意不设 rdfs:domain 与 rdfs:range——多值 domain/range 在 OWL 中是交集语义，九个主题域各指向不同实体类型，改由各主题域的 ∃ 限制公理分别表达。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#securedBy">
  <rdfs:domain rdf:resource="#LoanAccount"/>
  <rdfs:range rdf:resource="#Collateral"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">由押品担保</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款债权由押品提供担保，信用贷款无此关系。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasBeneficialOwner">
  <rdfs:domain rdf:resource="#CorporateCustomer"/>
  <rdfs:range rdf:resource="#BeneficialOwner"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受益所有人</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对公客户的最终受益自然人，反洗钱尽职调查的核查对象。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCreditRating">
  <rdfs:domain rdf:resource="#Customer"/>
  <rdfs:range rdf:resource="#CreditRating"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">信用评级</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户所获得的信用评级结果。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCreditLimit">
  <rdfs:domain rdf:resource="#Customer"/>
  <rdfs:range rdf:resource="#CreditLimit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">授信额度</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户获核定的可使用信用敞口上限。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#measuredBy">
  <rdfs:domain rdf:resource="#RiskEvent"/>
  <rdfs:range rdf:resource="#RiskIndicator"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">由指标度量</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险事件由风险指标量化反映。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasUserAccount">
  <rdfs:domain rdf:resource="#Employee"/>
  <rdfs:range rdf:resource="#UserAccount"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">持有系统账号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">员工在信息系统中的账号，是 RBAC 赋权的实际载体。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#holdsProduct">
  <rdfs:domain rdf:resource="#Customer"/>
  <rdfs:range rdf:resource="#FinancialProduct"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">持有产品</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户持有或购买的金融产品。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#conformsToStandard">
  <rdfs:domain rdf:resource="#DataEntity"/>
  <rdfs:range rdf:resource="#DataStandard"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">遵循数据标准</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据实体所遵循的数据标准。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#belongsToModel">
  <rdfs:domain rdf:resource="#DataEntity"/>
  <rdfs:range rdf:resource="#DataModel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">所属数据模型</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据实体所属的数据模型。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#governedByQualityRule">
  <rdfs:domain rdf:resource="#DataEntity"/>
  <rdfs:range rdf:resource="#DataQualityRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">受质量规则约束</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">数据实体须满足的数据质量规则。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasFieldMapping">
  <rdfs:domain rdf:resource="#MappingSpecification"/>
  <rdfs:range rdf:resource="#FieldMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">包含映射条目</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射规格所包含的字段映射条目。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inSpecification">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:range rdf:resource="#MappingSpecification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">所属映射规格</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">字段映射条目所归属的映射规格。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mapsSourceField">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:range rdf:resource="#SourceField"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射源字段</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射条目所取数的源表字段；未映射时可缺省。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSourceField">
  <rdfs:domain rdf:resource="#SourceTable"/>
  <rdfs:range rdf:resource="#SourceField"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">包含字段</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源系统表所包含的字段。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#belongsToTable">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#SourceField"/>
  <rdfs:range rdf:resource="#SourceTable"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">所属源表</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源字段所属的数据表。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#usesTransformationRule">
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:range rdf:resource="#TransformationRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">采用转换规则</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射条目所采用的加工逻辑。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#usesCodeMapping">
  <rdfs:domain rdf:resource="#FieldMapping"/>
  <rdfs:range rdf:resource="#CodeMapping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">采用代码对照</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射条目所引用的代码转换条目。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCoverage">
  <rdfs:domain rdf:resource="#MappingSpecification"/>
  <rdfs:range rdf:resource="#MappingCoverage"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">覆盖率快照</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">映射规格在某一时点的覆盖率度量结果。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#subOrganizationOf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#InternalOrganization"/>
  <rdfs:range rdf:resource="#InternalOrganization"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">上级机构</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">机构在组织层级中的直接上级。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#holdsPosition">
  <rdfs:domain rdf:resource="#Employee"/>
  <rdfs:range rdf:resource="#Position"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担任岗位</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">员工所担任的岗位，可兼任多个。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#positionRequiresRole">
  <rdfs:domain rdf:resource="#Position"/>
  <rdfs:range rdf:resource="#Role"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">岗位所需角色</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">履行岗位职能所需的系统角色，是 RBAC 赋权的依据。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#debitSubject">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#AccountingEntry"/>
  <rdfs:range rdf:resource="#AccountingSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">借方科目</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">分录中记入借方的会计科目。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#creditSubject">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#AccountingEntry"/>
  <rdfs:range rdf:resource="#AccountingSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷方科目</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">分录中记入贷方的会计科目。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inVoucher">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#AccountingEntry"/>
  <rdfs:range rdf:resource="#AccountingVoucher"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">所属凭证</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">分录所属的记账凭证。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inPeriod">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#AccountingVoucher"/>
  <rdfs:range rdf:resource="#AccountingPeriod"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">所属会计期间</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">凭证记账所归属的会计期间。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#affectsAccount">
  <rdfs:domain rdf:resource="#AccountingEntry"/>
  <rdfs:range rdf:resource="#Account"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">影响账户</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">分录所影响的账户。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ledgerOfAccount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#SubLedger"/>
  <rdfs:range rdf:resource="#Account"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">分户账对应账户</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">分户账所登记明细的账户。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#subjectOfLedger">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#GeneralLedger"/>
  <rdfs:range rdf:resource="#AccountingSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">总账科目</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">总账所归集的会计科目。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#guaranteedBy">
  <rdfs:domain rdf:resource="#Contract"/>
  <rdfs:range rdf:resource="#Guarantor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">由担保人担保</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">主合同所对应的担保人。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#underGuarantee">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#GuaranteeContract"/>
  <rdfs:range rdf:resource="#Contract"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">被担保主合同</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保合同所担保的主债权合同。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#secures">
  <rdfs:domain rdf:resource="#GuaranteeContract"/>
  <rdfs:range rdf:resource="#Collateral"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保物</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">担保合同项下对应的押品。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasInterestRate">
  <rdfs:domain rdf:resource="#FinancialProduct"/>
  <rdfs:range rdf:resource="#InterestRate"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">适用利率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产品所适用的利率定义。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#appliesRate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Account"/>
  <rdfs:range rdf:resource="#ExecutingRate"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账户执行利率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账户实际执行的利率。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#basedOnBenchmark">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ExecutingRate"/>
  <rdfs:range rdf:resource="#BenchmarkRate"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">挂钩基准利率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">执行利率所挂钩的基准利率。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasFeeItem">
  <rdfs:domain rdf:resource="#FinancialProduct"/>
  <rdfs:range rdf:resource="#FeeItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">适用收费项目</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产品所适用的收费项目。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inFeeSchedule">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#FeeItem"/>
  <rdfs:range rdf:resource="#FeeSchedule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">所属价目表</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">收费项目所归属的价目表。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasRiskLevel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Customer"/>
  <rdfs:range rdf:resource="#CustomerRiskLevel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户风险等级</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户在反洗钱口径下的风险评级结果。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#subjectToDueDiligence">
  <rdfs:domain rdf:resource="#Customer"/>
  <rdfs:range rdf:resource="#DueDiligence"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">开展尽职调查</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对客户开展的尽职调查活动。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#screenedBy">
  <rdfs:domain rdf:resource="#BankParty"/>
  <rdfs:range rdf:resource="#SanctionsScreening"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">经制裁筛查</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对参与方开展的制裁名单筛查。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mitigatedBy">
  <rdfs:domain rdf:resource="#Exposure"/>
  <rdfs:range rdf:resource="#RiskMitigation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">由缓释安排覆盖</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">降低该敞口风险的风险缓释安排。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasProvision">
  <rdfs:domain rdf:resource="#LoanAccount"/>
  <rdfs:range rdf:resource="#Provision"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">计提拨备</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贷款账户所计提的损失准备。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#impairs">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Impairment"/>
  <rdfs:range rdf:resource="#LoanAccount"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">减值对象</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">发生减值的贷款账户。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#basedOnRWA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#CapitalAdequacy"/>
  <rdfs:range rdf:resource="#RiskWeightedAsset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">基于风险加权资产</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资本充足率计量所依据的风险加权资产。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#producesError">
  <rdfs:domain rdf:resource="#BatchJob"/>
  <rdfs:range rdf:resource="#OperationalError"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">产生差错</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">批处理作业执行过程中产生的差错。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#reconcilesAccount">
  <rdfs:domain rdf:resource="#Reconciliation"/>
  <rdfs:range rdf:resource="#Account"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对账账户</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对账作业所核对的账户。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inSession">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ClearingTransaction"/>
  <rdfs:range rdf:resource="#SettlementSession"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">所属清算场次</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">清算交易所归属的清算场次。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#executedOn">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#BatchJob"/>
  <rdfs:range rdf:resource="#TechnicalComponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">运行于组件</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">批处理作业所运行的技术组件。</rdfs:comment>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#partyIdentifier">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#BankParty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">参与方编号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">客户号或员工号，全行唯一。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#accountNumber">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Account"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账户编号，全行唯一。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#transactionAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#FinancialTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易金额</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易的发生金额。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#currencyCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FinancialTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">币种代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">遵循 ISO 4217 的币种代码。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#transactionTimestamp">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#FinancialTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易时间</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">交易发生的时间戳。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fxRate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="#ForeignExchangeTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">成交汇率</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">外汇交易执行的兑换汇率。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#counterCurrencyCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#ForeignExchangeTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">对手币种代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">外汇交易中相对本币的另一币种，遵循 ISO 4217。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#valueDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#ForeignExchangeTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">起息日</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">外汇交易资金实际交割并计息的日期。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#remittanceCountryCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CrossBorderTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">汇款国家地区代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">汇款方所在国家或地区代码，遵循 ISO 3166。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#beneficiaryCountryCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CrossBorderTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">收款国家地区代码</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">收款方所在国家或地区代码，遵循 ISO 3166。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#declarationNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CrossBorderTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">国际收支申报号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">跨境收付对应的国际收支申报编号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#remittanceRefNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CrossBorderTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">汇款参考号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">跨境汇款的报文业务参考号。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#batchNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#AgencyTransaction"/>
