  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTCustomerItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">成立日期</rdfs:label>
