  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CashTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">柜员号</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">办理现金收付的柜员编号。</rdfs:comment>
