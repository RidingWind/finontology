<owl:DatatypeProperty rdf:about="#eastAccountStatus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTAccountItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账户状态</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">账户状态代码，如正常、久悬、销户。</rdfs:comment>
