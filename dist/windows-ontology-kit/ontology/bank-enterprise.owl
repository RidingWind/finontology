  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">存款期限，如三个月、六个月、一年。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastLoanNo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTLoanItem"/>
