  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:domain rdf:resource="#RegulatoryReport"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">记录条数</rdfs:label>
