<owl:NamedIndividual rdf:about="#RuleDirect">
  <rdf:type rdf:resource="#TransformationRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">直接映射</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源字段值原样填报，不做加工。</rdfs:comment>
  <ruleExpression rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target = source</ruleExpression>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RuleCodeConversion">
  <rdf:type rdf:resource="#TransformationRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">代码转换</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">源系统代码按代码表转换为监管口径代码或文本。</rdfs:comment>
  <ruleExpression rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target = codeMap[source]</ruleExpression>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RuleComputed">
  <rdf:type rdf:resource="#TransformationRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">计算派生</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">由一个或多个源字段经计算得到报送值。</rdfs:comment>
  <ruleExpression rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target = f(source...)</ruleExpression>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RuleConstant">
  <rdf:type rdf:resource="#TransformationRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">常量赋值</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">按监管口径填报固定常量值。</rdfs:comment>
  <ruleExpression rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target = const</ruleExpression>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RuleConcat">
  <rdf:type rdf:resource="#TransformationRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">字符串拼接</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">多个源字段按分隔符拼接为报送值。</rdfs:comment>
  <ruleExpression rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target = concat(source..., sep)</ruleExpression>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RuleConditional">
  <rdf:type rdf:resource="#TransformationRule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">条件分支</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">依据条件表达式选择不同的取值逻辑。</rdfs:comment>
  <ruleExpression rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target = cond ? a : b</ruleExpression>
</owl:NamedIndividual>

