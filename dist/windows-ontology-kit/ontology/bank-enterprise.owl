</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eastOpenDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#EASTAccountItem"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">开户日期</rdfs:label>
