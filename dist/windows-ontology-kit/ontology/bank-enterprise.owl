</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#discountDays">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:domain rdf:resource="#BillTransaction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">贴现天数</rdfs:label>
